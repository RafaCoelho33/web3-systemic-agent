# Server
PORT=8000
PUBLIC_API_URL=https://web3-systemic-agent.onrender.com

# LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAILOVER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.0-flash

# x402 Micropayments (eip155:84532 = Base Sepolia, eip155:8453 = Base Mainnet)
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000001
X402_ENABLED=true
X402_NETWORK=eip155:84532
X402_PRICE_TOKEN_CHECK=0.005
X402_PRICE_PREFLIGHT=0.01
X402_PRICE_EVALUATE=0.015
X402_PRICE_DEEP_AUDIT=0.25
X402_USE_LIVE_FACILITATOR=true
FACILITATOR_URL=https://x402.org/facilitator

# Coinbase CDP (required for Base Mainnet settlement)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
PUBLIC_EVALUATE_ONLY=true
ADMIN_API_KEY=

# RPC & Block Explorers (Etherscan/Basescan keys are optional fallbacks after Sourcify)
RPC_URL_8453=https://mainnet.base.org
RPC_URL_84532=https://sepolia.base.org
RPC_URL_42161=https://arb1.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# Background Block Scanner (optional)
# ENABLE_BACKGROUND_SCANNER=false
SCANNER_POLL_INTERVAL_SECONDS=60.0
SCANNER_CONTRACT_LIMIT=2
SCANNER_REQUIRE_HIGH_RISK_FOR_LLM=true
ENABLE_MULTI_CHANNEL_HUNTER=true
HUNTER_CHANNELS=dex_pools,geckoterminal_base,dexscreener_base,snapshot_daos

# Alerts (optional)
ALERT_WEBHOOK_URL=
