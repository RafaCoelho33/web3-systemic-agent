# ==============================================================================
# Web3 Condition-Action Trigger Agent - Environment Configuration Template
# ==============================================================================
# Copy this template to .env and customize values for your deployment:
#   cp .env.example .env
#
# IMPORTANT: Never commit production credentials or private keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server / Port Configuration
# ------------------------------------------------------------------------------
# HTTP port for the ASGI / FastAPI application server (used by Render and local runs)
PORT=8000

# ------------------------------------------------------------------------------
# LLM / Semantic Evaluator Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API key used for structured semantic evaluations
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model for semantic analysis
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# x402 Micropayment Protocol Configuration
# ------------------------------------------------------------------------------
# Recipient EVM address for USDC micropayments
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000001

# Master switch for x402 payment gatekeeper (true/false)
X402_ENABLED=true

# CAIP-2 Network Identifier:
# Use eip155:84532 for Base Sepolia testnet
# Use eip155:8453 for Base Mainnet production
X402_NETWORK=eip155:84532

# Price per semantic evaluation call in USDC (e.g. 0.05 USDC)
X402_PRICE_EVALUATE=0.05

# Facilitator Mode:
# Set to false to use internal mock facilitator for offline simulation/testing
# Set to true for live on-chain EIP-3009 settlement via remote HTTP facilitator
X402_USE_LIVE_FACILITATOR=true

# Facilitator service endpoint URL
FACILITATOR_URL=https://x402.org/facilitator

# Coinbase Developer Platform (CDP) API Credentials:
# Optional for Base Sepolia testnet (uses public facilitator https://x402.org/facilitator)
# Used for Base Mainnet production settlement (eip155:8453) via https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ------------------------------------------------------------------------------
# Rate Limiting & Security Hardening
# ------------------------------------------------------------------------------
# Maximum requests per minute per IP (0 to disable)
RATE_LIMIT_PER_MINUTE=60

# Public Evaluate-Only Lockdown (restricts public access strictly to evaluation endpoints)
PUBLIC_EVALUATE_ONLY=true

# Optional administrative API key to bypass evaluate-only lockdown (passed via X-Admin-Api-Key)
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# RPC & Web3 Network Configuration
# ------------------------------------------------------------------------------
# Base Sepolia RPC endpoint
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ------------------------------------------------------------------------------
# Webhooks and Service Discovery
# ------------------------------------------------------------------------------
# Destination URL for alert dispatches (Slack, Discord, custom webhook)
ALERT_WEBHOOK_URL=

# Public API URL base for service discovery and payment callback instructions
PUBLIC_API_URL=https://web3-systemic-agent.onrender.com
